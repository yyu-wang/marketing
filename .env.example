# =============================================================================
# CopyWise 后端服务 - 环境变量示例
# 使用方式：cp .env.example .env 并按环境修改
# 所有敏感信息（密钥/密码/Token）禁止硬编码进代码仓库
# =============================================================================

# 运行环境：development | staging | production
NODE_ENV=development

# 服务端口
PORT=3000

# 数据库配置（MySQL 8.0，需 utf8mb4 字符集以支持 emoji 与中文）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=copywise
DB_SYNC=false                 # 生产必须 false，仅开发可用 true 自动建表
DB_LOGGING=false              # 是否打印 SQL

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 鉴权配置
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d             # 令牌有效期

# 额度策略配置
QUOTA_DAILY_DEFAULT=10        # 每日默认上限
QUOTA_TZ=Asia/Shanghai        # 自然日重置时区（UTC+8）

# AI 服务配置（通义千问 / OpenAI 兼容接口）
AI_PROVIDER=qwen              # qwen | openai
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://ws-i4xu8p7fzj0lzko7.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-omni-flash     # 纯文本模型
AI_VISION_MODEL=qwen3.5-omni-plus-2026-03-15  # 含图片时的视觉模型
AI_TIMEOUT_MS=15000           # 超时熔断阈值（视觉模型建议 15s）

# 公网可访问基地址（用于上传图片生成绝对 URL 喂给视觉模型）
PUBLIC_BASE_URL=http://localhost:3000

# 限流策略
THROTTLE_TTL=60               # 时间窗口（秒）
THROTTLE_LIMIT=60             # 单 IP 单窗口最大请求数

# 腾讯云 COS 对象存储（图片上传）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=marketing-wise-1259102507
COS_REGION=ap-seoul
# 使用全球加速域名（解决部分区域默认域名的 SSL/TLS 兼容问题，需在 COS 控制台开启全球加速）
COS_USE_ACCELERATE=false
COS_CDN_DOMAIN=
